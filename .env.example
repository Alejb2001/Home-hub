# PostgreSQL — Neon connection string
# Get this from your Neon project dashboard > Connection Details
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Single-user auth credentials
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# JWT signing secret — use a long random string (e.g. openssl rand -base64 32)
JWT_SECRET=replace-with-a-long-random-secret

# Growatt / ShinePhone account credentials
GROWATT_USER=your@email.com
GROWATT_PASSWORD=your-shinephone-password
